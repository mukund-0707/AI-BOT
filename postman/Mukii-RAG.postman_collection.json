    {
      "name": "3. Chat",
      "item": [
        {
          "name": "Ask Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"answer is a non-empty string\", function () {",
                  "    pm.expect(body.answer).to.be.a(\"string\").and.to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"sources is an array\", function () {",
                  "    pm.expect(body.sources).to.be.an(\"array\");",
                  "});",
                  "",
                  "// Retrieval quality signal, not a hard failure.",
                  "if (body.answer.indexOf(\"couldn't find information\") !== -1) {",
                  "    console.warn(\"RETRIEVAL MISS: nothing scored above RAG_MIN_SCORE for this question.\");",
                  "}",
                  "",
                  "console.log(\"ANSWER:\", body.answer);",
                  "console.log(\"SOURCES:\", JSON.stringify(body.sources, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "X-CSRFToken",
                "value": "{{csrftoken}}",
                "description": "Required once a sessionid cookie exists, because AskQuestionView uses the default SessionAuthentication."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"question\": \"What is this policy document about?\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat/ask/", "host": ["{{base_url}}"], "path": ["api", "chat", "ask", ""] },
            "description": "The main RAG endpoint. Embeds the question, searches Qdrant, and asks the NVIDIA model to answer from the retrieved chunks."
          },
          "response": []
        },
        {
          "name": "Ask - section lookup (retrieval probe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const retrieved = body.answer.indexOf(\"developers and analysts\") !== -1;",
                  "const truncated = body.answer.indexOf(\"incomplete\") !== -1 ||",
                  "                  body.answer.indexOf(\"truncated\") !== -1;",
                  "",
                  "// Retrieval-quality probe, not a pass/fail assertion.",
                  "// Baseline (RAG_MIN_SCORE 0.70): missed entirely.",
                  "// After the threshold fix (0.35): the section is retrieved, but the answer",
                  "// still reports the text as incomplete because page headers/footers are",
                  "// not stripped before chunking, so the section gets cut mid-sentence.",
                  "console.log(retrieved ? \"section retrieved\" : \"SECTION MISSED\");",
                  "console.log(truncated ? \"text still truncated - boilerplate cleanup pending\" : \"full text returned\");",
                  "console.log(\"ANSWER:\", body.answer);",
                  "console.log(\"SOURCES:\", JSON.stringify(body.sources, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrftoken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"question\": \"Give me full text of: 3. For developers and analyst\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat/ask/", "host": ["{{base_url}}"], "path": ["api", "chat", "ask", ""] },
            "description": "Regression probe for exact-section lookups against the Gaia PDF.\n\nThe section is now retrieved (it was missed entirely when RAG_MIN_SCORE was 0.70), but the answer still calls the text incomplete: repeated page headers/footers are not stripped before chunking, so the section is split mid-sentence and the junk chunks outrank it.\n\nRe-run this after changing chunking or the text cleaner to see whether the full text comes back."
          },
          "response": []
        },
