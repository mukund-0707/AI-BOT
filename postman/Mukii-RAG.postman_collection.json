{
  "info": {
    "_postman_id": "b7e1c2a4-91f5-4d3a-8f6c-2a0d4e7b9c11",
    "name": "Mukii RAG Chatbot",
    "description": "API tests for the Mukii Django RAG chatbot.\n\n**Prerequisites**\n1. Qdrant must be running: `docker start qdrant` (check with the Infra > Qdrant requests).\n2. Django must be running: `python manage.py runserver`.\n3. Set `username` / `password` in the environment to a real Django user.\n\n**Run order matters.** Use the Collection Runner, or fire the requests top to bottom:\nGet CSRF Cookie -> Login -> Upload -> Ask -> Delete.\n\n**Why the CSRF dance?**\n`AskQuestionView` uses the project default `SessionAuthentication` (config/settings.py), which enforces CSRF once a session cookie exists. `UploadDocumentView` and `DeleteDocumentView` use `CsrfExemptSessionAuthentication`, so they do not. Django also rotates the CSRF token during login, so the token is re-captured after the Login request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "qdrant_url", "value": "http://localhost:6333", "type": "string" },
    { "key": "qdrant_collection", "value": "document_chunks", "type": "string" },
    { "key": "username", "value": "mukund", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "csrftoken", "value": "", "type": "string" },
    { "key": "document_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Get CSRF Cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// The chatbot page is decorated with @ensure_csrf_cookie, so hitting it",
                  "// hands us a csrftoken cookie to use on later POSTs.",
                  "let token = pm.cookies.get(\"csrftoken\");",
                  "",
                  "if (!token) {",
                  "    const setCookie = pm.response.headers.all()",
                  "        .filter(function (h) { return h.key.toLowerCase() === \"set-cookie\"; })",
                  "        .map(function (h) { return h.value; })",
                  "        .join(\"; \");",
                  "    const match = setCookie.match(/csrftoken=([^;]+)/);",
                  "    if (match) { token = match[1]; }",
                  "}",
                  "",
                  "if (token) { pm.collectionVariables.set(\"csrftoken\", token); }",
                  "",
                  "pm.test(\"csrftoken cookie captured\", function () {",
                  "    pm.expect(token, \"no csrftoken cookie returned\").to.be.a(\"string\").and.to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/chat/", "host": ["{{base_url}}"], "path": ["api", "chat", ""] },
            "description": "Loads the chatbot page purely to obtain a csrftoken cookie. Run this first."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"login succeeded\", function () {",
                  "    pm.expect(pm.response.json().message).to.eql(\"Login Successful\");",
                  "});",
                  "",
                  "// Django rotates the CSRF token on login, so the one captured earlier is",
                  "// now stale. Re-capture it or the Ask Question request will 403.",
                  "let token = pm.cookies.get(\"csrftoken\");",
                  "",
                  "if (!token) {",
                  "    const setCookie = pm.response.headers.all()",
                  "        .filter(function (h) { return h.key.toLowerCase() === \"set-cookie\"; })",
                  "        .map(function (h) { return h.value; })",
                  "        .join(\"; \");",
                  "    const match = setCookie.match(/csrftoken=([^;]+)/);",
                  "    if (match) { token = match[1]; }",
                  "}",
                  "",
                  "if (token) { pm.collectionVariables.set(\"csrftoken\", token); }",
                  "",
                  "pm.test(\"session cookie set\", function () {",
                  "    pm.expect(pm.cookies.has(\"sessionid\"), \"no sessionid cookie\").to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/accounts/login/", "host": ["{{base_url}}"], "path": ["api", "accounts", "login", ""] },
            "description": "Session login. This endpoint is @csrf_exempt, so no token is needed here.\nSets the sessionid cookie that Upload / Delete require."
          },
          "response": []
        },
        {
          "name": "Login - wrong password (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"returns Invalid credentials\", function () {",
                  "    pm.expect(pm.response.json().message).to.eql(\"Invalid credentials\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"definitely-not-the-password\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/accounts/login/", "host": ["{{base_url}}"], "path": ["api", "accounts", "login", ""] },
            "description": "Negative test. Run this AFTER the other requests, or re-run Login, because a failed login does not clear an existing session."
          },
          "response": []
        }
      ]
    },
